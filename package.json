{
  "name": "cchub-cli",
  "version": "1.0.0",
  "description": "Customer's Canvas Hub CLI client.",
  "main": "dist/cchub-cli.js",
  "type": "commonjs",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc && npm run bundle",
    "bundle": "tsup --config tsup.config.js",
    "dev": "tsx src/index.ts",
    "debug": "npm run dev --  projects create through-pipeline -s 1306 -d 0d4e1cf0-7755-4350-a46e-aa3d11b446f1 -o test -p 301",
    "start": "node dist/cchub-cli.js"
  },
  "dependencies": {
    "@aurigma/axios-asset-processor-api-client": "^2.76.4",
    "@aurigma/axios-asset-storage-api-client": "^2.76.5",
    "@aurigma/axios-backoffice-api-client": "^2.62.12",
    "@aurigma/axios-design-atoms-api-client": "^2.71.8",
    "@aurigma/axios-storefront-api-client": "^2.62.12",
    "@aurigma/design-atoms": "^7.1.72",
    "axios": "^1.13.5",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^9.5.0",
    "dotenv": "^17.2.2",
    "jwt-decode": "^4.0.0",
    "reflect-metadata": "^0.1.14",
    "tsyringe": "^4.10.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/node": "20.17",
    "cross-env": "^10.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.5",
    "typescript": "7.0.2"
  },
  "bin": {
    "cchub-cli": "dist/cchub-cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "author": "Andrew Simontsev",
  "license": "MIT"
}
